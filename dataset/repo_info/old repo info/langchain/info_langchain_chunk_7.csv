echo ""GOOGLE_AI_API_KEY=your_gemini_api_key_here"" > .env
echo ""ENVIRONMENT=development"" >> .env
```

### 3. Run the Application
```bash
# Start the server
uvicorn main:app --reload --host 0.0.0.0 --port 8000

# Open in browser
# http://localhost:8000
```

