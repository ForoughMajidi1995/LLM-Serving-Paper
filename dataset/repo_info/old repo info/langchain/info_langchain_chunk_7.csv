```yaml
# docker-compose.yml
version: '3.8'
services:
  rag-nitec:
    build: .
    ports:
      - ""8000:8000""
    environment:
      - GOOGLE_AI_API_KEY=${GOOGLE_AI_API_KEY}
      - ENVIRONMENT=production
    volumes:
      - ./models:/app/models
      - ./documents:/app/documents
    restart: unless-stopped
    
  nginx:
    image: nginx:alpine
    ports:
      - ""80:80""
      - ""443:443""
    volumes:
      - ./nginx.conf:/etc/nginx/nginx.conf
      - ./ssl:/etc/nginx/ssl
    depends_on:
      - rag-nitec
```

