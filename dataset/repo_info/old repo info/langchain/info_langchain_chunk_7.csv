COPY . .
EXPOSE 8000

CMD [""uvicorn"", ""src.main:app"", ""--host"", ""0.0.0.0"", ""--port"", ""8000""]
```

```bash
# Build and run
docker build -t credilinq-api .
docker run -p 8000:8000 --env-file .env credilinq-api
