brew install node


# パスを通す
export PATH=/usr/local/opt/node/bin:$PATH

# bash_profileのリロード
source ~/.bash_profile

# nodeの確認
# v18.19.0と表示されればOK
node -v

# yarnのインストール
npm install -g yarn

# yarnがインストールできているか確認
yarn -v

```

- 必要なモジュールのインストール

```
yarn
```

## 起動方法

```bash
yarn dev
```

Open [http://localhost:3000](http://localhost:3000) with your browser to see the result.

