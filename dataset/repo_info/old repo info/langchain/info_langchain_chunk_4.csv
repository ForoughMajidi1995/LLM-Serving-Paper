```mermaid
stateDiagram-v2
    [*] --> 📥PENDING : 任务提交
    
    📥PENDING --> 🏃RUNNING : 开始执行
    📥PENDING --> ❌CANCELLED : 用户取消
    
    🏃RUNNING --> ✅SUCCESS : 执行成功
    🏃RUNNING --> ❌FAILED : 执行失败
    🏃RUNNING --> ⏰TIMEOUT : 执行超时
    🏃RUNNING --> 📥PENDING : 重新排队
    
    ❌FAILED --> 🔄RETRY : 自动重试
    🔄RETRY --> 🏃RUNNING : 重新执行
    🔄RETRY --> ❌FAILED : 重试失败
    
    ✅SUCCESS --> [*] : 任务完成
    ❌FAILED --> [*] : 任务终止
    ⏰TIMEOUT --> [*] : 任务超时
    ❌CANCELLED --> [*] : 任务取消
    
    state 🏃RUNNING {
        [*] --> 🔍检索数据
        🔍检索数据 --> 🧮算法处理
        🧮算法处理 --> 🤖AI生成
        🤖AI生成 --> 💾结果存储
