│   ├── api.ts              # Type-safe API client
│   ├── hooks.ts            # React hooks
│   └── types.ts            # TypeScript definitions
├── 🔧 backend/              # Python FastAPI backend
│   ├── app/                # Application modules
│   │   ├── api.py          # API routes
│   │   ├── models.py       # Data models
│   │   ├── services.py     # Business logic
