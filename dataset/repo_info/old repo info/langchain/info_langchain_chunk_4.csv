export OPENAI_API_KEY=""sk-…""           # Windows PowerShell: setx OPENAI_API_KEY ""sk-…""
# • OR simply paste it into the UI when the app starts — no env setup required.

# 4 Fire it up
python app.py                          # then open http://127.0.0.1:5000
```

