# 优先级定义
class Priority(Enum):
    HIGH = 1     # 紧急任务
    MEDIUM = 2   # 常规任务  
    LOW = 3      # 批量任务

# 任务状态
class TaskStatus(Enum):
    PENDING = ""pending""
    RUNNING = ""running"" 
    SUCCESS = ""success""
    FAILED = ""failed""
    TIMEOUT = ""timeout""
```

