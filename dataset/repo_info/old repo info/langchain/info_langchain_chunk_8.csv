│   │   │   └── experiment_manager.py # Gestione esperimenti automatizzati
│   │   └── 📁 utils/                 # Utilità di supporto
│   │       ├── data_processor.py     # Caricamento e preprocessing dati
│   │       ├── rag_utils.py          # Sistema RAG (FAISS + BM25)
