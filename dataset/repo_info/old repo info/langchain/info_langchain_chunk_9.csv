class ChatState(TypedDict, total=False):
    """"""G.Navi AgentRAG 워크플로우 상태 모델""""""
    
    # === 📥 입력 데이터 (필수) ===
    user_question: str                   # 사용자 질문 텍스트
    user_data: Dict[str, Any]           # 사용자 프로필 정보
