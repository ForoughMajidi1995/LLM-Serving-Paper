    ""feedback about technical issues"",  # Auto-anonymised and classified
    session_id=""user_123""
)

# Collect user feedback
feedback = await agent.collect_feedback(
    session_id=""user_123"",
    rating=4,
    comment=""Very helpful analysis""  # Auto-anonymised
)
```

