        if is_scanned_pdf(file_path):
            text = ocr_pdf(file_path)
        else:
            text = extract_pdf_text(file_path)
      
        # 清理PDF特有噪声
        text = clean_pdf_artifacts(text)
      
    elif file_type == 'docx':
        # 保留格式信息
        text, formatting = extract_docx_with_formatting(file_path)
      
    # 通用文本清理
    text = clean_common_artifacts(text)
  
    return text
