cd backend
python -m venv venv
source venv/bin/activate  # or venv\Scripts\activate on Windows
pip install -r requirements.txt
Then run the backend:
bash
uvicorn main:app --reload

#Frontend#
bash
cd frontend
npm install
npm run dev
