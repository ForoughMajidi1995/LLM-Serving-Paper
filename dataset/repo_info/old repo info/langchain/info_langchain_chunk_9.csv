```python
# Multi-factor authentication
@router.post(""/auth/mfa/verify"")
async def verify_mfa(token: str, secret: str):
    totp = pyotp.TOTP(secret)
    return {""valid"": totp.verify(token, valid_window=1)}

# Role-based access control
@require_permissions([""missions:read"", ""drones:control""])
async def control_drone(drone_id: str, command: DroneCommand):
    return await drone_service.execute_command(drone_id, command)
```

