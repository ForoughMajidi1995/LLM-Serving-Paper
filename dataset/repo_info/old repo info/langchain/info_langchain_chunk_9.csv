├── galaxy-web-ui/          # Next.js 애플리케이션
│   ├── components/         # UI 컴포넌트
│   ├── app/                # 페이지 및 라우팅
│   ├── lib/                # 유틸리티 함수
│   └── package.json        # JS 의존성
└── README.md               # 프로젝트 문서
```"
