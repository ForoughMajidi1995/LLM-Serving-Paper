│   │     ├── prompts.py         
│   │     ├── requirements.txt    
│   │     └── utils.py    
│   └──venv
│
├── chatbot/
│   ├── public/              
│   ├── src/                 
│   │   ├── assets/  
│   │   ├── components/
│   │   │     ├──inputs/
│   │   │     │     ├── FileUpload.jsx
│   │   │     │     ├── Message.jsx 
│   │   │     ├──store  
│   │   │     │     └── CheckProvider.jsx  
│   │   │     └──Header.jsx         
│   │   ├── App.jsx           
│   │   ├── index.css           
