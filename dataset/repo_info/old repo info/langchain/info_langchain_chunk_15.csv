├── evaluators/                # 评价器（策略模式）
│   ├── base.py                # 基础评价器接口
│   ├── async_base.py          # 异步评价器基类
│   ├── factory.py             # 评价器工厂
│   ├── async_factory.py       # 异步评价器工厂
│   ├── async_academic_evaluator.py  # 异步学术评价器
│   ├── async_ragas_evaluator.py   # 异步Ragas评价器
