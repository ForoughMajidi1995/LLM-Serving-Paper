```bash
# Start RAG Backend (Development Tool)
cd knowledge_base/backend
source venv/bin/activate
python main.py

# Start Flutter Casino Game
flutter run

# Start Python Trading Service (Real Trading Integration)
cd python_trading_service
source venv/bin/activate
