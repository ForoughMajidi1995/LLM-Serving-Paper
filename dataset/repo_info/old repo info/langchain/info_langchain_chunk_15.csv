    def video_process(self, video_url: str):
        file_id=f""youtube_{hashlib.md5(video_url.encode()).hexdigest()[:8]}""
        if self._video_already_processed(video_url):
            print(""Video Already Processed. Skipping....."")
            self._last_file_id = file_id
            return self.collection
        temp_dir = tempfile.mkdtemp()
        temp_audio_path = os.path.join(temp_dir, 'temp_audio_yt.mp3')
        self._last_video_dir = temp_dir  # pentru cleanup ulterior

        print(""Downloading audio from URL..."")
        download_youtube_audio(video_url, output_path=temp_audio_path)

        if not os.path.exists(temp_audio_path):
            raise FileNotFoundError(f""Audio file not found: {temp_audio_path}"")

        print(""Transcribing audio..."")
        text = transcribe_audio(temp_audio_path)

        print(""Chunking and embedding..."")
        chunks = self._chunk_text(text)
        embedded = self.transformer(chunks)
        file_id = f""youtube_{hashlib.md5(video_url.encode()).hexdigest()[:8]}""
        self.vector_db(chunks, embedded, file=file_id)
        self._last_file_id = file_id



        try:
            shutil.rmtree(temp_dir)
            print(""Removing temporary directory"")
        except Exception as e:
            print(f""[WARNING] Could not delete temp dir: {e}"")

        return self.collection

    def video_ask(self, question: str) -> str:
        if not hasattr(self, ""_last_file_id""):
            raise ValueError(""No video was processed yet."")
        return self.query(file=self._last_file_id, question=question)

```

