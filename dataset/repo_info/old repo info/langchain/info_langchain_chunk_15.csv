            tts.save(temp_file)
        os.system(f""afplay {temp_file}"")
```
5. Remade the function `transformer` to make it faster and optimal to process files.  
If the time to transform the text into vectors is to long the batch will be divided in half and retry the process.
```python
    def transformer(self,chunks,batch_size=64):
        batch=batch_size
        while batch>0:
            try:
                return self.model.encode(chunks,batch_size=batch,show_progress_bar=True).tolist()
            except RuntimeError:
                print(f""RuntimeError. The batch size is too large. Will be reduce to {batch//2}"")
                batch=batch//2
        raise RuntimeError(""Embedding failed: batch size too small."")
```

6. Added a new variable in `__init__` named `self.memory`. With this new variable we can get rid os the chat_memory from before and use a more scalable approach.
```python
     def __init__(self,collection_name=""my_collection"",my_db=""my_db"",embedding_model=""all-mpnet-base-v2"",llm_model=""llama3.2""):
        self.collection_name=collection_name
        self.client=chromadb.PersistentClient(path=my_db)
        self.model=SentenceTransformer(embedding_model)
        self.llm=OllamaLLM(model=llm_model)
        self.collection=self._get_collection_create()
        self.memory=ConversationBufferMemory(chat_memory=ChatMessageHistory(),memory_key=""chat_history"",return_messages=True) #<- here 
```

7. The function `query` was modify so we won't need to process the question and the answer from the bot and append it in a list.  
Thanks to the library `from langchain.memory import ConversationBufferMemory`
```python
    def query(self,file,question,top_k=5):
        reform_question = self.llm.invoke(f""Reformat this question to be easier to search: {question}"")
        query_embeddings = self.model.encode(reform_question).tolist()
        result=self.collection.query(query_embeddings=[query_embeddings],n_results=top_k,where={""file"":file})
        document=result['documents'][0]
        context=""\n"".join(document)
        self.memory.chat_memory.add_user_message(question) #<-here
        prompt =(
            f""You are answering questions about a file. Use the context below and previous turns.\n""
            f""Context:\n{context}\n""
            f""Chat History:\n{self.memory.buffer}\n""
            f""Question: {question}"")
        response= self.llm.invoke(prompt)
        self.memory.chat_memory.add_ai_message(response) #<-here
        return response
```

8. Now you can choose if you want to save the conversation to a file, or you want it to disappear.
```python
    def save_in_file(self):
        timestamp=datetime.now().strftime(""%d-%m-%Y %H:%M:%S"")
        file_id=uuid.uuid4().hex[:6]
        filename=f'respons_{timestamp}_{file_id}.md'
        with open(filename,'w',encoding='utf-8') as f:
            for t in self.memory.buffer:
                if isinstance(t,HumanMessage):
                    f.write(f""Q:{t.content}\n"")
                elif isinstance(t,AIMessage):
                    f.write(f""A:{t.content}\n"")
                else:
                    f.write(f""Other: {t.content}"")
        print(f""Saved into file:{filename}"")
```
Using the `if isinstance(t,HumanMessage)` and `elif isinstance(t,AIMessage)` we can separate the question from the answer without doing it manually.  
Also added a timestamp and unique id with `timestamp` and `file_id`

9. Added a function outside the class named `choose_file` where we can select the files that we have in our folder.  
For this , use the library `glob`
```python
def choose_file(folder=""files""):
    files=glob.glob(f""{folder}/*"")
    if not files:
        print(""No files found"")
        exit()
    print(""Available files:"")
    for i,f in enumerate(files,1):
        print(f""{i}. {f}"")
    while True:
        try:
            choice=int(input(""Choose a file or press q to quit: ""))
            if 1<=choice<=len(files):
                return files[choice-1]
            else:
                print(""Invalid input"")
        except ValueError:
            break
```

10. Made a new method so you can speak if you don't want to type the question. By using the library `speech_recognition` and `pyaudio` we can record the users voice so the system can respond.
```python
    def speak(self):
        recognize = sr.Recognizer()
        recognize.pause_threshold =2.0 # if there is no sound for 2 seconds , it will stop
        try:
            print(""Available microphones:"")
            print(sr.Microphone.list_microphone_names())

            with sr.Microphone() as source:
                print(""Adjusting noise..."")
                recognize.adjust_for_ambient_noise(source, duration=1.5)
                print(""recording for 4 seconds"")
                recorded_audio = recognize.listen(source, timeout=4,phrase_time_limit=10)# timeout =the time it wait for the user to speak ; phrase_time_limit= time to speak is there is no silence detected
                print(""done"")
                text = recognize.recognize_google(recorded_audio)
                lang, _ = RAGProcessor._lang_detector(text)
                self.last_lang=lang
                return text


        except sr.UnknownValueError:
            print(""Could not understand audio"")
```
