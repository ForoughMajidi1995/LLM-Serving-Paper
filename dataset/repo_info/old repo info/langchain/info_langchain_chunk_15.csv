 │     7 class MermaidGraphBuilder:                                                                                │
 │     8     def __init__(self):                                                                                   │
 │     9         self.imports: Dict[str, Set[str]] = defaultdict(set)                                              │
 │    10                                                                                                           │
 │    11     def scan_kotlin_imports(self, file_path: str, content: str) -> Set[str]:                              │
 │    12         """"""Scans a Kotlin file's content for import statements.""""""                                        │
 │    13         imports = set()                                                                                   │
 │    14         for line in content.splitlines():                                                                 │
 │    15             match = re.match(r""^import\s+([\w\.\*]+)"", line.strip())                                      │
 │    16             if match:                                                                                     │
 │    17                 imports.add(match.group(1))                                                               │
 │    18         return imports                                                                                    │
 │    19                                                                                                           │
 │    20     def build_file_graph(self, source_dir: str) -> Dict[str, Set[str]]:                                   │
 │    21         """"""Builds a dependency graph for all Kotlin files in a directory.""""""                              │
 │    22         all_files = {}                                                                                    │
 │    23         for root, _, files in os.walk(source_dir):                                                        │
 │    24             for file in files:                                                                            │
 │    25                 if file.endswith('.kt'):                                                                  │
 │    26                     file_path = os.path.join(root, file)                                                  │
 │    27                     rel_path = os.path.relpath(file_path, source_dir)                                     │
 │    28                     with open(file_path, 'r', encoding='utf-8') as f:                                     │
 │    29                         content = f.read()                                                                │
 │    30                     all_files[rel_path] = self.scan_kotlin_imports(file_path, content)                    │
 │    31                                                                                                           │
 │    32         # This is a simplified graph construction. A real implementation would be more robust.            │
 │    33         adjacency = defaultdict(set)                                                                      │
 │    34         for file, imports in all_files.items():                                                           │
 │    35             for imp in imports:                                                                           │
 │    36                 for other_file, _ in all_files.items():                                                   │
 │    37                     if other_file != file and imp.endswith(other_file.split('/')[-1].replace('.kt', ''    │
 │       )):                                                                                                       │
 │    38                         adjacency[file].add(other_file)                                                   │
 │    39         return dict(adjacency)                                                                            │
