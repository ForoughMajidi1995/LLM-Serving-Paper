        # Execute query
        result = self.tool._run(query=""ticker:AAPL AND formType:\""10-K\"""")
        
        # Assertions
        self.assertIn(""filings"", result)
        self.assertEqual(1, len(result[""filings""]))
        self.assertEqual(""Apple Inc."", result[""filings""][0][""companyName""])
