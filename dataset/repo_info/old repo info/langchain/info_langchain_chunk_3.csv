from flask import Flask, request

app = Flask(__name__)

# Iniciar la app
@app.route(""/model"", methods=[""POST""])
def modelPost():
    print(""POST /model usado"")
    json_content = request.json
    query = json_content.get(""query"")
    print(f""query: {query}"")
