  ""message"": ""请分析这个UFO事件的可信度"",
  ""model"": ""gpt-4"",
  ""temperature"": 0.7
}

# 获取对话历史
GET /api/chat/history

# 清除对话历史
DELETE /api/chat/history
```

#### 图谱数据
