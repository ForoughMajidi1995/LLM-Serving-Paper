### End-to-End Testing

#### Browser Testing with Selenium

```python
# tests/test_e2e.py
import pytest
from selenium import webdriver
from selenium.webdriver.common.by import By
from selenium.webdriver.support.ui import WebDriverWait
from selenium.webdriver.support import expected_conditions as EC
import time

class TestE2E:
    @pytest.fixture
    def driver(self):
        # Setup Chrome driver
        options = webdriver.ChromeOptions()
        options.add_argument(""--headless"")
        driver = webdriver.Chrome(options=options)
        yield driver
        driver.quit()
    
    def test_chat_interaction(self, driver):
        # Navigate to application
        driver.get(""http://localhost:8000"")
        
        # Wait for chat button to be visible
        chat_button = WebDriverWait(driver, 10).until(
            EC.element_to_be_clickable((By.ID, ""chatbot-button""))
        )
        
        # Click chat button
        chat_button.click()
        
        # Wait for chat popup to appear
        chat_popup = WebDriverWait(driver, 10).until(
            EC.visibility_of_element_located((By.ID, ""chat-popup""))
        )
        
        # Find input field and send message
        input_field = driver.find_element(By.ID, ""user-input"")
        input_field.send_keys(""Hello, I need help"")
        
        # Click send button
        send_button = driver.find_element(By.ID, ""send-btn"")
        send_button.click()
        
        # Wait for response
        time.sleep(3)
        
        # Check if response is displayed
        messages = driver.find_elements(By.CLASS_NAME, ""message"")
        assert len(messages) >= 2  # User message + bot response
        
        # Verify bot response exists
        bot_messages = driver.find_elements(By.CLASS_NAME, ""bot"")
        assert len(bot_messages) > 0
```

