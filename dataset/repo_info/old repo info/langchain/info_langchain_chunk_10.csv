## Docker Deployment

### Local Docker Setup

#### Build and Run with Docker

```bash
# Build the Docker image
docker build -t dlytica-chatbot:latest .

# Run the container
docker run -d \
  --name dlytica-chatbot \
  -p 8000:8000 \
  --env-file .env \
  dlytica-chatbot:latest

# View logs
docker logs -f dlytica-chatbot

# Stop the container
docker stop dlytica-chatbot
```

#### Docker Compose Setup

Create a `docker-compose.yml` file:

```yaml
version: '3.8'

services:
  chatbot:
    build: .
    ports:
      - ""8000:8000""
    environment:
      - DB_HOST=postgres
      - DB_PORT=5432
      - DB_NAME=chatbot_db
      - DB_USER=academy-chatbot-postgres
      - DB_PASSWORD=postgres_bot
    depends_on:
      - postgres
    volumes:
      - ./docs:/app/docs
      - ./chroma_db:/app/chroma_db
    networks:
      - chatbot-network

  postgres:
    image: postgres:13
    environment:
      - POSTGRES_DB=chatbot_db
      - POSTGRES_USER=academy-chatbot-postgres
      - POSTGRES_PASSWORD=postgres_bot
    volumes:
      - postgres_data:/var/lib/postgresql/data
    ports:
      - ""5432:5432""
    networks:
      - chatbot-network

volumes:
  postgres_data:

networks:
  chatbot-network:
    driver: bridge
```

```bash
# Start all services
docker-compose up -d

# View logs
docker-compose logs -f chatbot

# Stop all services
docker-compose down

# Rebuild and restart
docker-compose up -d --build
```

### Production Docker Build

```bash
# Build for production
docker build -t quay.io/datanature_dev/jupyternotebook:dlytica-chatbot-v50 .

# Push to registry
docker push quay.io/datanature_dev/jupyternotebook:dlytica-chatbot-v50

# Pull and run in production
docker pull quay.io/datanature_dev/jupyternotebook:dlytica-chatbot-v50
docker run -d \
  --name dlytica-chatbot-prod \
  -p 8000:8000 \
  --env-file .env.production \
  quay.io/datanature_dev/jupyternotebook:dlytica-chatbot-v50
```

### Docker Optimization

#### Multi-stage Build Example

```dockerfile
# Build stage
FROM python:3.10-slim as builder

WORKDIR /app
COPY requirements.txt .
RUN pip install --user --no-cache-dir -r requirements.txt

# Production stage
FROM python:3.10-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev \
    poppler-utils \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Copy dependencies from builder stage
COPY --from=builder /root/.local /root/.local

# Copy application code
COPY . .

# Create non-root user
RUN useradd --create-home --shell /bin/bash chatbot && \
    chown -R chatbot:chatbot /app
USER chatbot

# Make sure scripts in .local are usable
ENV PATH=/root/.local/bin:$PATH

EXPOSE 8000

CMD [""uvicorn"", ""app:app"", ""--host"", ""0.0.0.0"", ""--port"", ""8000""]
```

