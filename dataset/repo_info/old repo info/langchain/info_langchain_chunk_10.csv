  title={BIASINSPECTOR: Detecting Bias in Structured Data through LLM Agents},
  author={Li, Haoxuan and Ma, Mingyu Derek and Huang, Jen-tse and Weng, Zhaotian and Wang, Wei and Zhao, Jieyu},
