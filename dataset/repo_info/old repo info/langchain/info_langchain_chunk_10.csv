# tests/test_database_integration.py
import pytest
from chatbot.database import Database
from datetime import datetime

class TestDatabaseIntegration:
    @pytest.fixture
    def db(self):
        # Use test database
        return Database(test_mode=True)
    
    def test_session_creation_and_retrieval(self, db):
