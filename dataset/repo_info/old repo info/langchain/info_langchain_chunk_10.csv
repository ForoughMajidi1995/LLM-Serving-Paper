### Data Protection

#### Input Sanitization

```python
# Input validation and sanitization
def sanitize_input(user_input: str) -> str:
    # Remove HTML tags
    cleaned = re.sub(r'<[^>]+>', '', user_input)
    
    # Escape special characters
    cleaned = html.escape(cleaned)
    
    # Limit length
    cleaned = cleaned[:1000]
    
    return cleaned.strip()
```

#### SQL Injection Prevention

```python
# Parameterized queries
def save_conversation(session_id: str, user_message: str, bot_response: str):
    query = """"""
    INSERT INTO conversation_history (session_id, user_message, bot_response, created_at)
    VALUES (%s, %s, %s, %s)
    """"""
    
    with db.get_cursor() as cursor:
        cursor.execute(query, (session_id, user_message, bot_response, datetime.now()))
```

### Privacy & Compliance

#### Data Retention Policy

```python
# Automatic data cleanup
def cleanup_old_data():
    # Delete conversations older than 90 days
    query = """"""
    DELETE FROM conversation_history 
    WHERE created_at < NOW() - INTERVAL '90 days'
    """"""
    
    # Delete expired sessions
    query = """"""
    DELETE FROM session_metadata 
    WHERE last_activity < NOW() - INTERVAL '7 days'
    """"""
```

#### GDPR Compliance

```python
# Data export for user requests
def export_user_data(user_email: str) -> dict:
    return {
        'conversations': get_user_conversations(user_email),
        'bookings': get_user_bookings(user_email),
        'preferences': get_user_preferences(user_email)
    }

# Data deletion for user requests
def delete_user_data(user_email: str):
    # Delete all user-related data
    queries = [
        ""DELETE FROM conversation_history WHERE user_email = %s"",
        ""DELETE FROM user_data WHERE email = %s"",
        ""DELETE FROM appointment_bookings WHERE email = %s""
    ]
    
    for query in queries:
        db.execute(query, (user_email,))
```

