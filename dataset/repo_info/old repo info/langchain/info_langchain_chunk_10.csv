# Minimum required for basic functionality
MAAS_PHI_4_API_KEY=your_api_key
MAAS_PHI_4_BASE_URL=https://your-endpoint.com/v1
MAAS_PHI_4_MODEL_NAME=microsoft/phi-4

JIRA_URL=https://issues.redhat.com/
