#### Docker Compose Setup

Create a `docker-compose.yml` file:

```yaml
version: '3.8'

services:
  chatbot:
    build: .
    ports:
      - ""8000:8000""
    environment:
      - DB_HOST=postgres
      - DB_PORT=5432
      - DB_NAME=chatbot_db
      - DB_USER=academy-chatbot-postgres
      - DB_PASSWORD=postgres_bot
    depends_on:
      - postgres
    volumes:
      - ./docs:/app/docs
      - ./chroma_db:/app/chroma_db
    networks:
      - chatbot-network

  postgres:
    image: postgres:13
    environment:
      - POSTGRES_DB=chatbot_db
      - POSTGRES_USER=academy-chatbot-postgres
      - POSTGRES_PASSWORD=postgres_bot
    volumes:
      - postgres_data:/var/lib/postgresql/data
    ports:
      - ""5432:5432""
    networks:
      - chatbot-network

volumes:
  postgres_data:

networks:
  chatbot-network:
    driver: bridge
```

