{
  ""classification"": {
    ""format"": ""Email"",
    ""intent"": ""RequestStatus""
  },
  ""result"": {
    ""sender"": ""john@example.com"",
    ""subject"": ""Request Update"",
    ""intent"": ""RequestStatus""
  },
  ""action"": {
    ""status"": ""Triggered status update process""
  }
}
```

