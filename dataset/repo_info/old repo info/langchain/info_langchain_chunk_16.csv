# config/advanced.yaml
mia:
  cognitive_architecture:
    attention_heads: 12
    hidden_size: 768
    intermediate_size: 3072
    max_position_embeddings: 2048
    
  llm_integration:
    temperature: 0.7
    top_p: 0.9
    max_tokens: 2048
    presence_penalty: 0.0
    frequency_penalty: 0.0
    
  memory_system:
    vector_dim: 1536
    max_memory_size: 100000
    similarity_threshold: 0.75
    retention_days: 30
    
  performance:
    batch_size: 32
    num_workers: 4
    prefetch_factor: 2
    pin_memory: true
    
  security:
