│   │   └── pdf_parser.py            # 📄 PDF processing & chunking
│   ├── vectorstore/
│   │   ├── embeddings.py            # 🧠 Embedding generation
│   │   └── vector_store.py          # 🔍 Vector storage & search
│   ├── llm/
│   │   ├── qa_chain.py              # 🤖 QA system & LLM management
